{
  "name": "garden",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit",
    "garden": "node lib/cli.ts",
    "prepare": "git config core.hooksPath hooks",
    "build": "node lib/cli.ts scan notes stream media && node lib/cli.ts links && astro build && (test ! -d media || cp -r media dist/media) && pagefind --site dist",
    "dev": "astro dev",
    "preview": "astro preview",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.64.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.8",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.3.0"
}
