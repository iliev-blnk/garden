---
import { getCollection, render } from 'astro:content'
import { backlinks } from '../../lib/site/backlinks.ts'
import { shortDate } from '../../lib/site/data.ts'
import Base from '../layouts/Base.astro'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  const links = backlinks(notes.map((n) => ({ slug: n.id, body: n.body ?? '' })))
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, from: (links.get(note.id) ?? []).map((s) => notes.find((n) => n.id === s)!) },
  }))
}

const { note, from } = Astro.props
const { Content } = await render(note)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const d = note.data
---
<Base title={d.title} description={d.summary}>
  <article class="note" data-pagefind-body>
    <div class="meta">
      <span class="stage">● {d.stage}</span>
      <span>planted {shortDate(d.planted)}</span>
      <span>tended {shortDate(d.tended)}</span>
      {d.topics.map((t) => <a href={`${base}/topics/${t}/`}>{t}</a>)}
      {d.rating !== undefined && <span>{d.rating}/10</span>}
    </div>
    <h1>{d.title}</h1>
    <p class="summary">{d.summary}</p>
    <div class="prose"><Content /></div>
    {from.length > 0 && (
      <nav class="links" aria-label="Linked from" data-pagefind-ignore>
        <p class="label">Linked from</p>
        <ul>{from.map((n) => <li><a href={`${base}/${n.id}/`}>{n.data.title}</a></li>)}</ul>
      </nav>
    )}
  </article>
</Base>
